<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/vault_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivIntruderPhoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_pin_digit"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_vault_lock" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محاولة اختراق ملتقطة"
                android:textColor="@color/vault_accent_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIntruderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="2026/09/26 23:45" />

            <TextView
                android:id="@+id/tvIntruderReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="إدخال رمز خاطئ 3 مرات"
                android:textColor="@color/text_disabled"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteIntruder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/vault_accent_red" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
