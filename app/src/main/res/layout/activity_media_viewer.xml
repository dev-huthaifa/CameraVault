<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Top Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/viewerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/text_primary" />

    <!-- Center Content -->
    <!-- Image View -->
    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/viewerBottomBar"
        app:layout_constraintTop_toBottomOf="@id/viewerToolbar" />

    <!-- Video View & Playback Container -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/viewerBottomBar"
        app:layout_constraintTop_toBottomOf="@id/viewerToolbar">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pin_digit"
            android:src="@drawable/ic_video"
            app:tint="@color/vault_accent_cyan" />
    </FrameLayout>

    <!-- Document / Text Preview Container -->
    <ScrollView
        android:id="@+id/documentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/viewerBottomBar"
        app:layout_constraintTop_toBottomOf="@id/viewerToolbar">

        <TextView
            android:id="@+id/tvDocumentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </ScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarViewer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/vault_accent_cyan"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:id="@+id/viewerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Unhide / Restore to Gallery Button -->
        <Button
            android:id="@+id/btnRestoreViewer"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#2600E676"
            android:text="@string/btn_restore"
            android:textColor="@color/vault_accent_green" />

        <!-- Secure Share Button -->
        <ImageButton
            android:id="@+id/btnShareViewer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_share"
            android:src="@drawable/ic_share"
            app:tint="@color/vault_accent_cyan" />

        <!-- Cryptographic Audit Button -->
        <ImageButton
            android:id="@+id/btnAuditViewer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audit"
            android:src="@drawable/ic_shield"
            app:tint="@color/vault_accent_gold" />

        <!-- Delete Permanently Button -->
        <ImageButton
            android:id="@+id/btnDeleteViewer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/vault_accent_red" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
